# Which build to run: "latest" (newest release), a release such as v1.0.1, or
# "edge" (every commit on main). IMAGE_OWNER is only needed for a fork that
# publishes its own images (lowercase GitHub user/org).
IMAGE_TAG=latest
# IMAGE_OWNER=argseby

WEB_PORT=8080
SITE_ADDRESS=:80
MAX_TABLES=100
TABLE_RETENTION_DAYS=90

# Voice chat and video across networks: STUN servers the browsers may ask for
# their public address (comma-separated, stun: or stuns:). Public STUN servers
# need no account; the one below is Google's. Empty = same network only, no
# third party. No media ever passes through a STUN server or this instance.
# VOICE_STUN_URLS=stun:stun.l.google.com:19302


# Behind an existing reverse proxy: attach the web container to that Docker network
# instead of publishing a port (see README). COMPOSE_FILE saves the -f flags.
# PROXY_NETWORK=proxy-network
# COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.proxy.yml
