# Which build to run: "latest" (newest release), a release such as v1.0.1, or
# "edge" (every commit on main). IMAGE_OWNER is only needed for a fork that
# publishes its own images (lowercase GitHub user/org).
IMAGE_TAG=latest
# IMAGE_OWNER=argseby

WEB_PORT=8080
SITE_ADDRESS=:80
MAX_TABLES=100
TABLE_RETENTION_DAYS=90

# Player profiles: a name, a password and a recovery code, so a player can
# keep their statistics across tables. Off by default — a game among friends
# needs no sign-in, and guests can always play either way. No mail is ever
# sent: a forgotten password is recovered with the code shown at sign-up.
# ACCOUNTS=true

# Sign in with revoked (https://docs.revoked.link) next to the password.
# Needs ACCOUNTS=true and PUBLIC_ORIGIN. revoked is something people run
# themselves, so no server is configured here: the request goes to the
# player's Revoked app, which answers on the server that player uses, and
# names it in the answer. Nothing is registered anywhere in advance.
# REVOKED_SIGN_IN=true
# The address players reach this instance at, no path. It is this
# instance's OpenID client id, and the revoked server checks that the
# address it sends the player back to sits on it.
# PUBLIC_ORIGIN=https://poker.example
# Restrict sign-ins to named revoked servers (comma-separated origins).
# Empty, the default, accepts any server a player names.
# REVOKED_ISSUERS=https://revoked.example

# Whether a player may be told what to do on their turn — fold, check, call or
# raise — by the same strategy the bots play. On by default; the host of a
# table can refuse it there, and this refuses it for the whole instance.
# It governs the recommendation and nothing else: the name of a player's own
# hand, the cards that make it and what the board threatens are their own
# cards read back to them, and stay whatever this is set to.
# PLAYER_ADVICE=false

# Voice and video across networks: STUN servers the browsers may ask for their
# public address (comma-separated, stun: or stuns:). Public STUN servers need
# no account; the one below is Google's. Empty = same network only, no third
# party. No media ever passes through a STUN server or this instance.
# (Called VOICE_STUN_URLS in the first releases; that name still works.)
# Two servers let the app recognise a symmetric NAT and tell the player.
# WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# A TURN relay for players whose networks block direct connections (strict NAT,
# mobile carriers). Needs your own coturn or a hosted TURN service with
# long-term credentials; media then passes through that relay. All three
# variables are required together. turn: or turns: URLs, comma-separated.
# WEBRTC_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# WEBRTC_TURN_USERNAME=showdown
# WEBRTC_TURN_CREDENTIAL=change-me


# Behind an existing reverse proxy: attach the web container to that Docker network
# instead of publishing a port (see README). COMPOSE_FILE saves the -f flags.
# PROXY_NETWORK=proxy-network
# COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.proxy.yml
# The web container proxies /api and /ws to this address. The default is the
# api container's own alias and needs no change; set it only if something
# else on the proxy network already answers to that name.
# API_UPSTREAM=showdown-api:8080
