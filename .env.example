WEB_PORT=8080
SITE_ADDRESS=:80
MAX_TABLES=100
TABLE_RETENTION_DAYS=90

# Voice chat across networks: STUN servers the browsers may ask for their public
# address (comma-separated, stun: or stuns:). Empty = same network only, no third party.
# VOICE_STUN_URLS=stun:stun.l.google.com:19302

# Only needed to pull or publish prebuilt images (lowercase GitHub user/org)
# IMAGE_OWNER=your-github-user
